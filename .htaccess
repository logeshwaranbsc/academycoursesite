# Hostinger Shared Hosting Root .htaccess
# Directs all traffic into public/ while protecting private directories and files.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to sensitive root files and directories
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|app|config|database|resources|routes|storage) - [F,L,NC]

    # Rewrite requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
